<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Restablecer contraseña | PCinBOX</title>
    <style>
      :root {
        --brand: #bb3d4b;
        --brand-dark: #952f3b;
        --ink: #111827;
        --muted: #6b7280;
        --line: #e5e7eb;
        --soft: #f8fafc;
        --pad-x: clamp(16px, 4vw, 48px);
        --pad-y: clamp(18px, 3.5vw, 40px);
        --input-h: clamp(46px, 6vw, 56px);
        --radius: clamp(14px, 2vw, 22px);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: clamp(12px, 3vw, 40px);
        font-family: Arial, Helvetica, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(900px 420px at 10% -10%, rgba(187, 61, 75, 0.18), transparent 55%),
          radial-gradient(700px 380px at 110% 110%, rgba(187, 61, 75, 0.12), transparent 50%),
          #eef1f5;
      }

      /* Móvil full-bleed fluido; tablet/desktop más anchos */
      .wrap {
        width: min(100%, 720px);
        margin-inline: auto;
      }

      .card {
        background: #fff;
        border: 1px solid rgba(229, 231, 235, 0.95);
        border-radius: var(--radius);
        box-shadow: 0 20px 48px rgba(15, 23, 42, 0.1);
        overflow: hidden;
      }

      .head {
        padding: var(--pad-y) var(--pad-x) calc(var(--pad-y) * 0.85);
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        color: #fff;
      }

      .head h1 {
        font-size: clamp(1.35rem, 2.8vw + 0.6rem, 2rem);
        font-weight: 700;
        letter-spacing: 0.01em;
        margin-bottom: 0.45em;
        line-height: 1.2;
      }

      .head p {
        font-size: clamp(0.9rem, 1.2vw + 0.55rem, 1.05rem);
        line-height: 1.5;
        opacity: 0.94;
        max-width: 52ch;
      }

      .body {
        padding: var(--pad-y) var(--pad-x) calc(var(--pad-y) * 1.1);
      }

      .alert {
        display: none;
        border-radius: 12px;
        padding: clamp(12px, 2vw, 16px) clamp(12px, 2.5vw, 18px);
        margin-bottom: clamp(12px, 2vw, 18px);
        font-size: clamp(0.875rem, 1vw + 0.55rem, 0.95rem);
        line-height: 1.45;
      }

      .alert.show { display: block; }

      .alert-ok {
        background: #ecfdf5;
        color: #166534;
        border: 1px solid #bbf7d0;
      }

      .alert-err {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }

      .field { margin-bottom: clamp(14px, 2.2vw, 20px); }

      .field label {
        display: block;
        margin-bottom: 8px;
        font-size: clamp(0.8rem, 1vw + 0.5rem, 0.9rem);
        font-weight: 700;
        color: #374151;
      }

      .pwd { position: relative; }

      .pwd input {
        width: 100%;
        height: var(--input-h);
        border: 1.5px solid var(--line);
        border-radius: 12px;
        padding: 0 52px 0 14px;
        font-size: 16px; /* evita zoom iOS */
        background: var(--soft);
        color: var(--ink);
      }

      .pwd input:focus {
        outline: none;
        background: #fff;
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(187, 61, 75, 0.14);
      }

      .eye {
        position: absolute;
        top: 50%;
        right: 8px;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        border: 0;
        border-radius: 10px;
        background: transparent;
        color: #6b7280;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .eye:hover {
        background: #f3f4f6;
        color: var(--brand);
      }

      .eye .icon-show { display: block; }
      .eye .icon-hide { display: none; }
      .eye.is-visible .icon-show { display: none; }
      .eye.is-visible .icon-hide { display: block; }

      .hint {
        margin: 2px 0 clamp(16px, 2.5vw, 22px);
        padding: clamp(10px, 2vw, 14px) clamp(12px, 2vw, 16px);
        border-radius: 12px;
        background: var(--soft);
        border: 1px solid var(--line);
        font-size: clamp(0.8rem, 1vw + 0.5rem, 0.9rem);
        color: var(--muted);
        line-height: 1.45;
      }

      .btn {
        width: 100%;
        height: var(--input-h);
        border: 0;
        border-radius: 12px;
        background: var(--brand);
        color: #fff;
        font-size: clamp(0.95rem, 1vw + 0.55rem, 1.05rem);
        font-weight: 700;
        cursor: pointer;
      }

      .btn:hover:not(:disabled) { filter: brightness(0.96); }
      .btn:disabled { opacity: 0.7; cursor: not-allowed; }

      .btn.loading {
        position: relative;
        color: transparent;
      }

      .btn.loading::after {
        content: "";
        position: absolute;
        inset: 0;
        margin: auto;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2.5px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        animation: spin .75s linear infinite;
      }

      @keyframes spin { to { transform: rotate(360deg); } }

      .done {
        display: none;
        margin-top: 12px;
      }

      .done.show { display: block; }

      .done a,
      .blocked-actions a {
        display: grid;
        place-items: center;
        height: var(--input-h);
        border-radius: 12px;
        color: #fff;
        text-decoration: none;
        font-size: clamp(0.95rem, 1vw + 0.55rem, 1.05rem);
        font-weight: 700;
      }

      .done a { background: #111827; }

      .blocked-actions {
        display: none;
        margin-top: 8px;
      }

      .blocked-actions.show { display: block; }
      .blocked-actions a { background: var(--brand); }

      .foot {
        margin-top: clamp(12px, 2vw, 18px);
        text-align: center;
        font-size: clamp(0.8rem, 1vw + 0.5rem, 0.9rem);
        color: var(--muted);
      }

      .foot a {
        color: var(--brand);
        font-weight: 700;
        text-decoration: none;
      }

      /* Teléfonos estrechos */
      @media (max-width: 480px) {
        body { padding: 10px; align-content: start; padding-top: max(10px, env(safe-area-inset-top)); }
        .wrap { width: 100%; }
        .card { border-radius: 16px; }
        .head p { max-width: none; }
      }

      /* Tablet */
      @media (min-width: 481px) and (max-width: 900px) {
        .wrap { width: min(100%, 640px); }
      }

      /* Desktop / pantallas grandes */
      @media (min-width: 901px) {
        .wrap { width: min(92vw, 760px); }
        .pwd input { font-size: 17px; }
      }

      @media (min-width: 1280px) {
        .wrap { width: min(90vw, 820px); }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="card">
        <div class="head">
          <h1>Nueva contraseña</h1>
          <p>Define una contraseña segura para tu cuenta. El enlace es personal y caduca en 6 horas.</p>
        </div>

        <div class="body">
          <div id="okMsg" class="alert alert-ok" role="status"></div>
          <div
            id="errMsg"
            class="alert alert-err<%= linkStatus && linkStatus !== 'ok' ? ' show' : '' %>"
            role="alert"
          >
            <span id="errText"><%= linkMessage || '' %></span>
          </div>

          <form
            id="resetForm"
            method="post"
            action="javascript:void(0)"
            autocomplete="off"
            novalidate
            style="<%= linkStatus && linkStatus !== 'ok' ? 'display:none' : '' %>"
          >
            <!-- Solo el token identifica el reset; el idUser dueño sale de la DB en el server -->
            <input type="hidden" id="token" name="token" value="<%= token || '' %>" autocomplete="off" />

            <input type="text" name="username" value="" autocomplete="username" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0" />

            <div class="field">
              <label for="np1">Nueva contraseña</label>
              <div class="pwd">
                <input
                  type="password"
                  id="np1"
                  name="np1"
                  placeholder="Mínimo 8 caracteres"
                  autocomplete="new-password"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  inputmode="text"
                  required
                  minlength="8"
                  readonly
                  data-lpignore="true"
                  data-1p-ignore="true"
                  data-form-type="other"
                />
                <button type="button" class="eye" data-target="np1" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                  <svg class="icon-show" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.88 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.88-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
                  <svg class="icon-hide" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/><path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/></svg>
                </button>
              </div>
            </div>

            <div class="field">
              <label for="np2">Confirmar contraseña</label>
              <div class="pwd">
                <input
                  type="password"
                  id="np2"
                  name="np2"
                  placeholder="Repite tu contraseña"
                  autocomplete="new-password"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  inputmode="text"
                  required
                  minlength="8"
                  readonly
                  data-lpignore="true"
                  data-1p-ignore="true"
                  data-form-type="other"
                />
                <button type="button" class="eye" data-target="np2" aria-label="Mostrar confirmación" title="Mostrar confirmación">
                  <svg class="icon-show" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.88 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.88-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
                  <svg class="icon-hide" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/><path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/></svg>
                </button>
              </div>
            </div>

            <div class="hint">Mínimo 8 caracteres. Máximo 3 solicitudes de recuperación por día.</div>

            <button type="submit" id="submitBtn" class="btn">Guardar contraseña</button>
          </form>

          <div id="doneBox" class="done">
            <a id="loginLink" href="<%= linkApp || '/' %>">Ir a iniciar sesión</a>
          </div>

          <div
            id="blockedBox"
            class="blocked-actions<%= linkStatus && linkStatus !== 'ok' ? ' show' : '' %>"
          >
            <a href="<%= linkApp || '/' %>">Volver al inicio</a>
          </div>
        </div>
      </div>

      <p class="foot">
        ¿Ayuda? <a href="https://www.pcinbox.com.mx">pcinbox.com.mx</a>
      </p>
    </div>

    <script src="/js/reset-password.js"></script>
  </body>
</html>
