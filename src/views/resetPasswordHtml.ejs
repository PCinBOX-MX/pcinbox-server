<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Restablecer contraseña | PCinBOX</title>
    <style>
      :root {
        --brand: #bb3d4b;
        --brand-dark: #952f3b;
        --ink: #111827;
        --muted: #6b7280;
        --line: #e5e7eb;
        --soft: #f8fafc;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 20px 14px;
        font-family: Arial, Helvetica, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(900px 420px at 10% -10%, rgba(187, 61, 75, 0.18), transparent 55%),
          radial-gradient(700px 380px at 110% 110%, rgba(187, 61, 75, 0.12), transparent 50%),
          #eef1f5;
      }

      .wrap {
        width: 100%;
        max-width: 380px;
      }

      .logo {
        display: flex;
        justify-content: center;
        margin-bottom: 14px;
      }

      .logo img {
        width: 52px;
        height: 52px;
        object-fit: contain;
        border-radius: 14px;
        background: #fff;
        border: 1px solid var(--line);
        padding: 8px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
      }

      .card {
        background: #fff;
        border: 1px solid rgba(229, 231, 235, 0.95);
        border-radius: 16px;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
        overflow: hidden;
      }

      .head {
        padding: 16px 18px 14px;
        background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        color: #fff;
      }

      .head h1 {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.01em;
        margin-bottom: 4px;
      }

      .head p {
        font-size: 12.5px;
        line-height: 1.4;
        opacity: 0.92;
      }

      .body {
        padding: 16px 18px 18px;
      }

      .alert {
        display: none;
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 12px;
        font-size: 13px;
        line-height: 1.4;
      }

      .alert.show { display: block; }

      .alert-ok {
        background: #ecfdf5;
        color: #166534;
        border: 1px solid #bbf7d0;
      }

      .alert-err {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }

      .field { margin-bottom: 12px; }

      .field label {
        display: block;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 700;
        color: #374151;
      }

      .pwd {
        position: relative;
      }

      .pwd input {
        width: 100%;
        height: 42px;
        border: 1.5px solid var(--line);
        border-radius: 10px;
        padding: 0 42px 0 12px;
        font-size: 14px;
        background: var(--soft);
        color: var(--ink);
      }

      .pwd input:focus {
        outline: none;
        background: #fff;
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(187, 61, 75, 0.14);
      }

      .eye {
        position: absolute;
        top: 50%;
        right: 6px;
        transform: translateY(-50%);
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #6b7280;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .eye:hover {
        background: #f3f4f6;
        color: var(--brand);
      }

      .eye .off { display: none; }
      .eye.on .on { display: none; }
      .eye.on .off { display: block; }

      .hint {
        margin: 2px 0 12px;
        padding: 9px 11px;
        border-radius: 10px;
        background: var(--soft);
        border: 1px solid var(--line);
        font-size: 11.5px;
        color: var(--muted);
        line-height: 1.4;
      }

      .btn {
        width: 100%;
        height: 42px;
        border: 0;
        border-radius: 10px;
        background: var(--brand);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
      }

      .btn:hover:not(:disabled) { filter: brightness(0.96); }
      .btn:disabled { opacity: 0.7; cursor: not-allowed; }

      .btn.loading {
        position: relative;
        color: transparent;
      }

      .btn.loading::after {
        content: "";
        position: absolute;
        inset: 0;
        margin: auto;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2.5px solid rgba(255,255,255,0.35);
        border-top-color: #fff;
        animation: spin .75s linear infinite;
      }

      @keyframes spin { to { transform: rotate(360deg); } }

      .done {
        display: none;
        margin-top: 10px;
      }

      .done.show { display: block; }

      .done a {
        display: grid;
        place-items: center;
        height: 42px;
        border-radius: 10px;
        background: #111827;
        color: #fff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
      }

      .foot {
        margin-top: 12px;
        text-align: center;
        font-size: 11.5px;
        color: var(--muted);
      }

      .foot a {
        color: var(--brand);
        font-weight: 700;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="logo">
        <img
          src="https://ik.imagekit.io/pcinboxkit/logos/logo.png?updatedAt=1759534318587"
          alt="PCinBOX"
          width="52"
          height="52"
        />
      </div>

      <div class="card">
        <div class="head">
          <h1>Nueva contraseña</h1>
          <p>Define una contraseña segura para tu cuenta PCinBOX.</p>
        </div>

        <div class="body">
          <div id="okMsg" class="alert alert-ok" role="status"></div>
          <div id="errMsg" class="alert alert-err" role="alert">
            <span id="errText"></span>
          </div>

          <!-- autocomplete=off + nombres no estándar + readonly hasta foco -->
          <form id="resetForm" method="post" action="javascript:void(0)" autocomplete="off" novalidate>
            <input type="hidden" id="token" value="" autocomplete="off" />
            <input type="hidden" id="idUser" value="" autocomplete="off" />

            <!-- honeypot / decoy fields for password managers -->
            <input type="text" name="username" value="" autocomplete="username" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0" />

            <div class="field">
              <label for="np1">Nueva contraseña</label>
              <div class="pwd">
                <input
                  type="password"
                  id="np1"
                  name="np1"
                  placeholder="Mínimo 8 caracteres"
                  autocomplete="new-password"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  inputmode="text"
                  required
                  minlength="8"
                  readonly
                  data-lpignore="true"
                  data-1p-ignore="true"
                  data-form-type="other"
                />
                <button type="button" class="eye" data-target="np1" aria-label="Mostrar contraseña">
                  <svg class="on" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.88 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.88-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
                  <svg class="off" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/><path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/></svg>
                </button>
              </div>
            </div>

            <div class="field">
              <label for="np2">Confirmar contraseña</label>
              <div class="pwd">
                <input
                  type="password"
                  id="np2"
                  name="np2"
                  placeholder="Repite tu contraseña"
                  autocomplete="new-password"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  inputmode="text"
                  required
                  minlength="8"
                  readonly
                  data-lpignore="true"
                  data-1p-ignore="true"
                  data-form-type="other"
                />
                <button type="button" class="eye" data-target="np2" aria-label="Mostrar confirmación">
                  <svg class="on" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.88 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.88-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg>
                  <svg class="off" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/><path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/></svg>
                </button>
              </div>
            </div>

            <div class="hint">Mínimo 8 caracteres. Este enlace es personal y temporal.</div>

            <button type="submit" id="submitBtn" class="btn">Guardar contraseña</button>
          </form>

          <div id="doneBox" class="done">
            <a id="loginLink" href="<%= linkApp || '/' %>">Ir a iniciar sesión</a>
          </div>
        </div>
      </div>

      <p class="foot">
        ¿Ayuda? <a href="https://www.pcinbox.com.mx">pcinbox.com.mx</a>
      </p>
    </div>

    <script src="/js/reset-password.js"></script>
  </body>
</html>
