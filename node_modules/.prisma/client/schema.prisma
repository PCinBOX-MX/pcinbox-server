  reason         String?   @db.Text
  payload        Json?
  createdAt      DateTime  @default(now()) @db.DateTime(0)
  pos_sales      pos_sales @relation(fields: [posSaleId], references: [idPosSale], onDelete: Cascade, onUpdate: NoAction, map: "fk_pos_sale_events_posSaleId")
  users          users?    @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_sale_events_userId")

  @@index([posSaleId], map: "idx_pos_sale_events_posSaleId")
  @@index([createdAt], map: "idx_pos_sale_events_createdAt")
}

model inventory_movements {
  idInventoryMovement BigInt    @id @default(autoincrement())
  productId           BigInt
  branchId            BigInt?
  userId              BigInt?
  delta               Int
  reason              String    @db.VarChar(64)
  refType             String?   @db.VarChar(64)
  refId               String?   @db.VarChar(64)
  note                String?   @db.VarChar(255)
  createdAt           DateTime  @default(now()) @db.DateTime(0)
  products            products  @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_movements_productId")
  branches            branches? @relation(fields: [branchId], references: [idBranche], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_movements_branchId")
  users               users?    @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_movements_userId")

  @@index([productId, createdAt], map: "idx_inventory_movements_product_created")
  @@index([branchId], map: "idx_inventory_movements_branchId")
  @@index([refType, refId], map: "idx_inventory_movements_ref")
  @@index([createdAt], map: "idx_inventory_movements_createdAt")
  @@index([branchId, createdAt], map: "idx_inventory_movements_branch_createdAt")
}

enum pos_sales_status {
