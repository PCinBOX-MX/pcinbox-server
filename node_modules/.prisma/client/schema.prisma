/// Sesión de caja por sucursal (Fase 2 POS).
model pos_cash_sessions {
  idCashSession    BigInt                  @id @default(autoincrement())
  branchId         BigInt
  openedByUserId   BigInt
  closedByUserId   BigInt?
  status           pos_cash_session_status @default(open)
  openingFloat     Decimal                 @db.Decimal(12, 2)
  closingCounted   Decimal?                @db.Decimal(12, 2)
  expectedCash     Decimal?                @db.Decimal(12, 2)
  difference       Decimal?                @db.Decimal(12, 2)
  /// Motivo obligatorio cuando hay descuadre (difference ≠ 0) al cerrar.
  differenceReason String?                 @db.VarChar(500)
  notes            String?                 @db.Text
  openedAt         DateTime                @default(now()) @db.DateTime(0)
  closedAt         DateTime?               @db.DateTime(0)
  branches         branches                @relation(fields: [branchId], references: [idBranche], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_cash_sessions_branchId")
  openedBy         users                   @relation("pos_cash_opened_by", fields: [openedByUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_cash_sessions_openedBy")
  closedBy         users?                  @relation("pos_cash_closed_by", fields: [closedByUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_cash_sessions_closedBy")
  movements        pos_cash_movements[]
  sales            pos_sales[]

  @@index([branchId, status], map: "idx_pos_cash_sessions_branch_status")
  @@index([openedAt], map: "idx_pos_cash_sessions_openedAt")
}

model pos_cash_movements {
  idCashMovement BigInt                 @id @default(autoincrement())
  cashSessionId  BigInt
  userId         BigInt
  type           pos_cash_movement_type
  amount         Decimal                @db.Decimal(12, 2)
  reason         String?                @db.VarChar(255)
  posSaleId      BigInt?
  createdAt      DateTime               @default(now()) @db.DateTime(0)
  session        pos_cash_sessions      @relation(fields: [cashSessionId], references: [idCashSession], onDelete: Cascade, onUpdate: NoAction, map: "fk_pos_cash_movements_session")
  users          users                  @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_cash_movements_userId")

  @@index([cashSessionId], map: "idx_pos_cash_movements_session")
  @@index([createdAt], map: "idx_pos_cash_movements_createdAt")
  @@index([cashSessionId, createdAt], map: "idx_pos_cash_movements_session_createdAt")
  @@index([posSaleId], map: "idx_pos_cash_movements_posSaleId")
}

enum pos_cash_session_status {
  open
  closed
}

enum pos_cash_movement_type {
  cash_in
  cash_out
  sale_cash
  sale_cash_void
}

