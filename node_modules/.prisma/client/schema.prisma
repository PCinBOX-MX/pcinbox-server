generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categories {
  idCategorie    BigInt           @id @default(autoincrement())
  name           String           @db.VarChar(100)
  categoriamapeo categoriamapeo[]
  products       products[]
}

model products {
  idProduct           BigInt                @id @default(autoincrement())
  idProductExt        String?               @db.VarChar(255)
  name                String                @db.VarChar(150)
  description         String?               @db.Text
  caracteristicas     Json?
  price               Decimal               @db.Decimal(10, 2)
  stock               Int
  sku                 String?               @db.VarChar(255)
  upc                 String?               @db.VarChar(255)
  width               Float?
  height              Float?
  largo               Float?
  peso                Float?
  rating              Float?
  image_url           Json?
  categoryId          BigInt?
  marcaId             BigInt?
  providerId          BigInt
  isPC                Int?                  @db.TinyInt
  licenseType         String?               @db.VarChar(20)
  requiresSerial      Boolean               @default(false)
  warrantyMonths      Int?
  /// months | none | service_center (años se guardan como meses)
  warrantyMode        String?               @db.VarChar(32)
  createdAt           DateTime?             @default(now()) @db.DateTime(0)
  active              Int?                  @default(1) @db.TinyInt
  cartItems           cartItems[]
  favorites           favorites[]
  product_stock       product_stock[]
  categories          categories?           @relation(fields: [categoryId], references: [idCategorie], onDelete: NoAction, onUpdate: NoAction, map: "fk_categorieId_products")
  marca               marca?                @relation(fields: [marcaId], references: [idMarca], onDelete: NoAction, onUpdate: NoAction, map: "fk_marcaId_products")
  providers           providers             @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_providerId_products")
  reviews             reviews[]
  sales               sales[]
  pos_sale_items      pos_sale_items[]
  inventory_movements inventory_movements[]
  product_serials     product_serials[]

  @@index([providerId], map: "fk_providerId_products_idx")
  @@index([marcaId], map: "fk_marcaId_products_idx")
  @@index([categoryId], map: "fk_categoriaId_products_idx")
  @@index([licenseType], map: "products_software_license_idx")
  @@index([categoryId, active, providerId], map: "products_catalog_list_idx")
  @@index([active, providerId], map: "products_active_provider_idx")
  @@index([active], map: "idx_products_active")
  @@index([sku], map: "products_sku_idx")
  @@index([upc], map: "products_upc_idx")
  @@index([idProductExt], map: "idx_products_idProductExt")
}

model providers {
  idProvider         BigInt               @id @default(autoincrement())
  companyName        String               @db.VarChar(100)
  contactEmail       String?              @db.VarChar(100)
  phone              String?              @db.VarChar(50)
  address            String?              @db.Text
  branches           branches[]
  categoriamapeo     categoriamapeo[]
  marcamapeo         marcamapeo[]
  products           products[]
  products_providers products_providers[]
}

model users {
  idUser                   BigInt                @id @default(autoincrement())
  name                     String                @db.VarChar(100)
  lastname                 String?               @db.VarChar(100)
  email                    String                @db.VarChar(100)
  password                 String?               @db.VarChar(255)
  phone                    String?               @db.VarChar(45)
  phonePromptDismissedAt   DateTime?             @db.DateTime(0)
  role                     users_role            @default(customer)
  customerId               String?               @db.VarChar(255)
  createdAT                DateTime?             @default(now()) @db.DateTime(0)
  active                   Int?                  @default(1) @db.TinyInt
  addresses                addresses[]
  billing                  billing[]
  cards                    cards[]
  carts                    carts[]
  changepassword           changepassword[]
  favorites                favorites[]
  order                    order[]
  cotizaciones             cotizaciones[]
  reservas                 reservas[]
  resetpassword            resetpassword[]
  sales                    sales[]
  pos_sales_cashier        pos_sales[]           @relation("pos_sales_cashier")
  pos_sales_customer       pos_sales[]           @relation("pos_sales_customer")
  pos_sale_events          pos_sale_events[]
  inventory_movements      inventory_movements[]
  pos_cash_opened          pos_cash_sessions[]   @relation("pos_cash_opened_by")
  pos_cash_closed          pos_cash_sessions[]   @relation("pos_cash_closed_by")
  pos_cash_movements       pos_cash_movements[]
  product_serials_customer product_serials[]     @relation("product_serials_customer")

  @@index([email], map: "idx_users_email")
  @@index([role, active], map: "idx_users_role_active")
}

model resetpassword {
  idResetPassword BigInt    @id @default(autoincrement())
  idUser          BigInt
  refreshToken    String    @db.VarChar(255)
  expiryToken     String    @db.VarChar(255)
  createdAT       DateTime? @default(now()) @db.DateTime(0)
  active          Boolean   @default(true)
  users           users     @relation(fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "resetpassword_ibfk_1")

  @@index([idUser], map: "idUser")
}

/// Códigos OTP pendientes antes de crear la cuenta en /register.
model register_email_codes {
  id             BigInt    @id @default(autoincrement())
  email          String    @db.VarChar(100)
  codeHash       String    @db.VarChar(255)
  name           String    @db.VarChar(100)
  lastname       String    @db.VarChar(100)
  phone          String?   @db.VarChar(45)
  passwordHash   String    @db.VarChar(255)
  resendCount    Int       @default(0)
  verifyAttempts Int       @default(0)
  lastResendAt   DateTime? @db.DateTime(0)
  expiresAt      DateTime  @db.DateTime(0)
  consumedAt     DateTime? @db.DateTime(0)
  createdAt      DateTime  @default(now()) @db.DateTime(0)

  @@index([email], map: "register_email_codes_email_idx")
  @@map("register_email_codes")
}

model cartItems {
  idCartItem BigInt   @id @default(autoincrement())
  carId      BigInt
  productId  BigInt
  storeId    Int?
  quantity   Int?
  active     Int?     @default(1) @db.TinyInt
  carts      carts    @relation(fields: [carId], references: [idCart], onDelete: NoAction, onUpdate: NoAction, map: "fk_card_id_cart")
  products   products @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_id_cart")

  @@index([carId], map: "fk_card_id_cart_idx")
  @@index([productId], map: "fk_product_id_cart_idx")
  @@map("cart_items")
}

model carts {
  idCart    BigInt        @id @default(autoincrement())
  userId    BigInt
  status    carts_status? @default(active)
  createdAt DateTime?     @default(now()) @db.DateTime(0)
  cartItems cartItems[]
  users     users         @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_userId_car")

  @@index([userId], map: "fk_userId_car_idx")
}

model changepassword {
  idChangePassword BigInt    @id @default(autoincrement())
  userId           BigInt
  createdAt        DateTime? @default(now()) @db.DateTime(0)
  users            users     @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "changepassword_ibfk_1")

  @@index([userId], map: "userId")
}

model addresses {
  idAddress  BigInt      @id @default(autoincrement())
  userId     BigInt
  street     String?     @db.VarChar(255)
  noExt      String      @db.VarChar(10)
  noInt      String?     @db.VarChar(10)
  cologne    String?     @db.VarChar(100)
  city       String?     @db.VarChar(100)
  state      String?     @db.VarChar(100)
  country    String?     @db.VarChar(100)
  postalCode String?     @db.VarChar(10)
  phone1     String?     @db.VarChar(100)
  phone2     String?     @db.VarChar(100)
  createdAt  DateTime?   @default(now()) @db.DateTime(0)
  updatedAt  DateTime?   @default(now()) @db.DateTime(0)
  active     Int?        @default(1) @db.TinyInt
  users      users       @relation(fields: [userId], references: [idUser], onDelete: Cascade, onUpdate: NoAction, map: "addresses_ibfk_1")
  shipments  shipments[]

  @@index([userId], map: "userId")
}

model billing {
  idBilling    BigInt             @id @default(autoincrement())
  userId       BigInt
  companyName  String?            @db.VarChar(100)
  rfc          String?            @db.VarChar(100)
  cfdi         String?            @db.VarChar(50)
  taxRegimen   String?            @db.VarChar(50)
  methodPay    billing_methodPay?
  codePostal   String?            @db.VarChar(10)
  cologne      String?            @db.VarChar(50)
  state        String?            @db.VarChar(100)
  city         String?            @db.VarChar(100)
  street       String?            @db.VarChar(100)
  noExt        String?            @db.VarChar(50)
  noInt        String?            @db.VarChar(50)
  observations String?            @db.Text
  country      billing_country?   @default(M_xico)
  createdAt    DateTime?          @default(now()) @db.DateTime(0)
  active       Int?               @default(1) @db.TinyInt
  users        users              @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "billing_ibfk_1")

  @@index([userId], map: "userId")
  @@index([userId, active], map: "billing_userId_active_idx")
}

model cotizaciones {
  idCotizacion           BigInt   @id @default(autoincrement())
  quoteNumber            String   @unique(map: "cotizaciones_quoteNumber_key") @db.VarChar(64)
  idempotencyKey         String   @unique(map: "cotizaciones_idempotencyKey_key") @db.VarChar(100)
  userId                 BigInt
  cartHash               String   @db.Char(64)
  checkoutMode           String   @db.VarChar(16)
  storageKey             String   @unique(map: "cotizaciones_storageKey_key") @db.VarChar(64)
  originalFileName       String   @db.VarChar(255)
  mimeType               String   @default("application/pdf") @db.VarChar(100)
  sizeBytes              Int
  sha256                 String   @db.Char(64)
  totalAmount            Decimal  @db.Decimal(12, 2)
  itemCount              Int
  includeAssemblyService Boolean  @default(false)
  /// Líneas del carrito al generar (productId, quantity, storeId) para rehidratación POS.
  linesJson              Json?
  active                 Int      @default(1) @db.TinyInt
  createdAt              DateTime @default(now()) @db.DateTime(0)
  expiresAt              DateTime @db.DateTime(0)
  users                  users    @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "cotizaciones_userId_fkey")

  @@index([userId, createdAt], map: "cotizaciones_userId_createdAt_idx")
  @@index([userId, cartHash, createdAt], map: "cotizaciones_user_cart_created_idx")
  @@index([active, createdAt], map: "cotizaciones_active_createdAt_idx")
  @@index([createdAt], map: "cotizaciones_createdAt_idx")
  @@index([expiresAt], map: "cotizaciones_expiresAt_idx")
  @@index([originalFileName], map: "cotizaciones_originalFileName_idx")
}

model reviews {
  idReview     BigInt    @id @default(autoincrement())
  productId    BigInt
  rating       Float?
  title        String?   @db.VarChar(255)
  description  String?   @db.VarChar(255)
  date         DateTime? @db.DateTime(0)
  reviewerName String?   @db.VarChar(100)
  userId       BigInt?
  products     products  @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_1")

  @@index([productId], map: "productId")
}

model favorites {
  idFavorite  BigInt    @id @default(autoincrement())
  userId      BigInt
  productId   BigInt
  favoritedAt DateTime? @default(now()) @db.DateTime(0)
  active      Int?      @default(1) @db.TinyInt
  users       users     @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "favorites_ibfk_1")
  products    products  @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "favorites_ibfk_2")

  @@index([productId], map: "productId")
  @@index([userId], map: "userId")
  @@index([userId, productId], map: "favorites_user_product_idx")
}

model cards {
  idRegisterCard  BigInt    @id @default(autoincrement())
  userId          BigInt?
  cardId          String?   @db.VarChar(255)
  lastFourDigits  String?   @db.VarChar(4)
  brand           String?   @db.VarChar(250)
  expirationMonth Int?
  expirationYear  Int?
  createdAt       DateTime? @default(now()) @db.Timestamp(0)
  active          Int?      @default(1) @db.TinyInt
  users           users?    @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "cards_ibfk_1")

  @@index([userId], map: "userId")
}

model order {
  idOrder               BigInt                 @id @default(autoincrement())
  userId                BigInt
  totalAmount           Decimal                @db.Decimal(10, 2)
  idPreferenceMP        String?                @db.Text
  idPayMP               String?                @db.Text
  stripePaymentIntentId String?                @db.VarChar(255)
  status                order_status?
  paidAtOxxo            Int?
  shipping_method       order_shipping_method?
  pay_method            order_pay_method?
  oxxo_reference        String?                @db.VarChar(255)
  gatewayPaymentId      String?                @db.VarChar(255)
  payment_plan          Int?
  createdAt             DateTime?              @db.DateTime(0)
  updatedAt             DateTime?              @db.DateTime(0)
  requiredFactura       Int?                   @db.TinyInt
  active                Int?                   @default(1) @db.TinyInt
  cancelReason          String?                @db.Text
  cardLast4             String?                @db.VarChar(4)
  users                 users                  @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_userId_order")
  purchases             purchases[]
  refunds               refunds[]
  sales                 sales[]
  shipments             shipments[]

  @@index([userId], map: "fk_userId_order_idx")
}

model shipments {
  idShipment       BigInt                     @id @default(autoincrement())
  orderId          BigInt?
  groupKey         String?                    @db.VarChar(255)
  addressId        BigInt?
  trackingNumber   String?                    @db.VarChar(255)
  lastStatus       String?                    @db.VarChar(255)
  lastLocation     String?                    @db.VarChar(255)
  lastUpdated      DateTime?                  @db.DateTime(0)
  status           shipments_status?
  statusChangedAt  DateTime?                  @db.DateTime(0)
  storeId          Int?
  shipping_method  shipments_shipping_method?
  shippingCost     Decimal?                   @db.Decimal(10, 2)
  insuranceCost    Decimal?                   @db.Decimal(10, 2)
  createdAt        DateTime?                  @db.DateTime(0)
  requireInsurance Int?                       @db.TinyInt
  sales            sales[]
  order            order?                     @relation(fields: [orderId], references: [idOrder], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_id_shipments")
  addresses        addresses?                 @relation(fields: [addressId], references: [idAddress], onDelete: NoAction, onUpdate: NoAction, map: "fn_addressId_shipments")

  @@index([orderId], map: "fk_order_id_shipments_idx")
  @@index([addressId], map: "db_address_id_shipments_idx")
  @@index([groupKey], map: "shipments_group_key_idx")
}

model refunds {
  idRefund        BigInt          @id @default(autoincrement())
  orderId         BigInt?
  amount          Int?
  reason          String?         @db.VarChar(255)
  status          refunds_status?
  gatewayRefundId String?         @db.VarChar(255)
  createdAt       DateTime?       @default(now()) @db.DateTime(0)
  updatedAt       DateTime?       @db.DateTime(0)
  order           order?          @relation(fields: [orderId], references: [idOrder], onDelete: NoAction, onUpdate: NoAction, map: "refunds_ibfk_1")

  @@index([orderId], map: "orderId")
}

model transfers {
  idTransfer        BigInt            @id @default(autoincrement())
  amount            Int?
  currency          String?           @db.VarChar(50)
  status            transfers_status?
  gatewayTransferId String?           @db.VarChar(255)
  createdAt         DateTime?         @default(now()) @db.DateTime(0)
  updatedAt         DateTime?         @db.DateTime(0)
}

model marca {
  idMarca     BigInt       @id @default(autoincrement())
  name        String?      @db.VarChar(255)
  description String?      @db.VarChar(255)
  marcamapeo  marcamapeo[]
  products    products[]
}

model sales {
  idSale             BigInt            @id @default(autoincrement())
  orderId            BigInt
  shipmentId         BigInt?
  productId          BigInt
  userId             BigInt
  purchaseId         String?           @db.VarChar(255)
  invoiceNumber      String?           @db.VarChar(255)
  quantity           Int?
  total              Decimal?          @db.Decimal(10, 2)
  status             sales_status?
  shipStatus         shipments_status?
  statusChangedAt    DateTime?         @db.DateTime(0)
  licenseDeliveredAt DateTime?         @db.DateTime(0)
  createdAt          DateTime?         @default(now()) @db.DateTime(0)
  order              order             @relation(fields: [orderId], references: [idOrder], onDelete: NoAction, onUpdate: NoAction, map: "fk_orderId_sales")
  products           products          @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_productId_sales")
  shipments          shipments?        @relation(fields: [shipmentId], references: [idShipment], onDelete: NoAction, onUpdate: NoAction, map: "fk_shipmentId_sales")
  users              users             @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_userId_sales")

  @@index([orderId], map: "fk_orderId_sales_idx")
  @@index([productId], map: "fk_productId_sales")
  @@index([userId], map: "fk_userId_sales")
  @@index([shipmentId], map: "fk_shipmentId_sales_idx")
}

model categoriamapeo {
  idCategoriaMapeo BigInt      @id @default(autoincrement())
  nameExt          String      @db.VarChar(255)
  providerId       BigInt?
  categoriaLocalId BigInt?
  createdAt        DateTime?   @default(now()) @db.DateTime(0)
  categories       categories? @relation(fields: [categoriaLocalId], references: [idCategorie], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoriamapeo_categoriasLocalId")
  providers        providers?  @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoriamapeo_providerId")

  @@index([categoriaLocalId], map: "fk_categoriamapeo_categoriasLocalId_idx")
  @@index([providerId], map: "fk_categoriamapeo_providerId_idx")
}

model marcamapeo {
  idMarcaMapeo BigInt    @id @default(autoincrement())
  nameExt      String    @db.VarChar(255)
  providerId   BigInt
  marcaLocalId BigInt
  createdAt    DateTime  @default(now()) @db.DateTime(0)
  marca        marca     @relation(fields: [marcaLocalId], references: [idMarca], onDelete: NoAction, onUpdate: NoAction, map: "fk_marcamapeo_marcaLocalId")
  providers    providers @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_marcamapeo_providerId")

  @@index([providerId], map: "fk_maramapeo_providerId_idx")
  @@index([marcaLocalId], map: "fk_marcamapeo_marcaLocalId_idx")
}

model branches {
  idBranche           BigInt                @id @default(autoincrement())
  name                String?               @db.VarChar(255)
  city                String?               @db.VarChar(255)
  providerId          BigInt
  providers           providers             @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_providerId_branches")
  product_stock       product_stock[]
  pos_sales           pos_sales[]
  pos_sale_items      pos_sale_items[]
  inventory_movements inventory_movements[]
  pos_cash_sessions   pos_cash_sessions[]
  product_serials     product_serials[]

  @@index([providerId], map: "fk_providerId_branches_idx")
}

/// Ventas de mostrador (Punto de Venta). Independientes de `order` web.
model pos_sales {
  idPosSale         BigInt             @id @default(autoincrement())
  folio             String             @unique(map: "uk_pos_sales_folio") @db.VarChar(32)
  branchId          BigInt
  cashierUserId     BigInt
  customerUserId    BigInt?
  customerName      String?            @db.VarChar(255)
  status            pos_sales_status   @default(completed)
  subtotal          Decimal            @db.Decimal(12, 2)
  discountTotal     Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  notes             String?            @db.Text
  /// 1 = cliente pidió factura al cobrar; 0 = no.
  requiredFactura   Int                @default(0) @db.TinyInt
  cancelReason      String?            @db.Text
  cancelledAt       DateTime?          @db.DateTime(0)
  cancelledByUserId BigInt?
  customerEmail     String?            @db.VarChar(255)
  customerPhone     String?            @db.VarChar(45)
  paymentLinkUrl    String?            @db.Text
  checkoutLinkUrl   String?            @db.Text
  linkReferencia    String?            @db.VarChar(64)
  idLinkPago        Int?
  cashSessionId     BigInt?
  /// Folio de cotización web (quoteNumber) si la venta nació de una cotización.
  quoteNumber       String?            @db.VarChar(64)
  /// Clave anti doble-cobro (cliente). Única; null en ventas legacy.
  idempotencyKey    String?            @unique(map: "uk_pos_sales_idempotencyKey") @db.VarChar(64)
  createdAt         DateTime           @default(now()) @db.DateTime(0)
  updatedAt         DateTime           @default(now()) @updatedAt @db.DateTime(0)
  branches          branches           @relation(fields: [branchId], references: [idBranche], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_sales_branchId")
  cashier           users              @relation("pos_sales_cashier", fields: [cashierUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_sales_cashierUserId")
  customer          users?             @relation("pos_sales_customer", fields: [customerUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_sales_customerUserId")
  cashSession       pos_cash_sessions? @relation(fields: [cashSessionId], references: [idCashSession], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_sales_cashSessionId")
  items             pos_sale_items[]
  payments          pos_payments[]
  events            pos_sale_events[]
  serials           product_serials[]

  @@index([branchId], map: "idx_pos_sales_branchId")
  @@index([cashierUserId], map: "idx_pos_sales_cashierUserId")
  @@index([customerUserId], map: "idx_pos_sales_customerUserId")
  @@index([status, createdAt], map: "idx_pos_sales_status_createdAt")
  @@index([createdAt], map: "idx_pos_sales_createdAt")
  @@index([cashSessionId], map: "idx_pos_sales_cashSessionId")
  @@index([quoteNumber], map: "idx_pos_sales_quoteNumber")
  @@index([branchId, createdAt], map: "idx_pos_sales_branch_createdAt")
  @@index([customerName], map: "idx_pos_sales_customerName")
  @@index([idLinkPago], map: "idx_pos_sales_idLinkPago")
  @@index([linkReferencia], map: "idx_pos_sales_linkReferencia")
}

model pos_sale_items {
  idPosSaleItem BigInt            @id @default(autoincrement())
  posSaleId     BigInt
  productId     BigInt
  /// Bodega/almacén de origen del stock (por proveedor: CDMX/GDL, leon2/santafe, etc.)
  branchId      BigInt?
  productName   String            @db.VarChar(255)
  productSku    String?           @db.VarChar(255)
  productUpc    String?           @db.VarChar(255)
  quantity      Int
  unitPrice     Decimal           @db.Decimal(12, 2)
  discountPct   Decimal           @default(0) @db.Decimal(5, 2)
  lineTotal     Decimal           @db.Decimal(12, 2)
  pos_sales     pos_sales         @relation(fields: [posSaleId], references: [idPosSale], onDelete: Cascade, onUpdate: NoAction, map: "fk_pos_sale_items_posSaleId")
  products      products          @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_sale_items_productId")
  branches      branches?         @relation(fields: [branchId], references: [idBranche], onDelete: NoAction, onUpdate: NoAction, map: "fk_pos_sale_items_branchId")
  serials       product_serials[]

  @@index([posSaleId], map: "idx_pos_sale_items_posSaleId")
  @@index([productId], map: "idx_pos_sale_items_productId")
  @@index([branchId], map: "idx_pos_sale_items_branchId")
}

/// Unidades serializadas (GPU, laptop, etc.) — Fase 3 POS.
model product_serials {
  idProductSerial   BigInt                @id @default(autoincrement())
  productId         BigInt
  serialNumber      String                @db.VarChar(128)
  branchId          BigInt?
  status            product_serial_status @default(available)
  posSaleId         BigInt?
  posSaleItemId     BigInt?
  customerUserId    BigInt?
  customerName      String?               @db.VarChar(255)
  soldAt            DateTime?             @db.DateTime(0)
  warrantyMonths    Int?
  /// months | none | service_center (snapshot al vender)
  warrantyMode      String?               @db.VarChar(32)
  warrantyExpiresAt DateTime?             @db.DateTime(0)
  notes             String?               @db.VarChar(500)
  createdAt         DateTime              @default(now()) @db.DateTime(0)
  updatedAt         DateTime              @default(now()) @updatedAt @db.DateTime(0)
  products          products              @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_serials_productId")
  branches          branches?             @relation(fields: [branchId], references: [idBranche], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_serials_branchId")
  pos_sales         pos_sales?            @relation(fields: [posSaleId], references: [idPosSale], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_serials_posSaleId")
  pos_sale_items    pos_sale_items?       @relation(fields: [posSaleItemId], references: [idPosSaleItem], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_serials_posSaleItemId")
  customer          users?                @relation("product_serials_customer", fields: [customerUserId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_serials_customer")

  @@unique([serialNumber], map: "uk_product_serials_serialNumber")
  @@index([productId], map: "idx_product_serials_productId")
  @@index([status], map: "idx_product_serials_status")
  @@index([posSaleId], map: "idx_product_serials_posSaleId")
  @@index([branchId], map: "idx_product_serials_branchId")
  @@index([posSaleItemId], map: "idx_product_serials_posSaleItemId")
  @@index([updatedAt], map: "idx_product_serials_updatedAt")
  @@index([productId, status], map: "idx_product_serials_product_status")
}

enum product_serial_status {
  available
  sold
  rma
  returned
}

model pos_payments {
  idPosPayment BigInt             @id @default(autoincrement())
  posSaleId    BigInt
  method       pos_payment_method
  amount       Decimal            @db.Decimal(12, 2)
  reference    String?            @db.VarChar(255)
  createdAt    DateTime           @default(now()) @db.DateTime(0)
  pos_sales    pos_sales          @relation(fields: [posSaleId], references: [idPosSale], onDelete: Cascade, onUpdate: NoAction, map: "fk_pos_payments_posSaleId")

  @@index([posSaleId], map: "idx_pos_payments_posSaleId")
}

model pos_sale_events {
