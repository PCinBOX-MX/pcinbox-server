generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categories {
  idCategorie    BigInt           @id @default(autoincrement())
  name           String           @db.VarChar(100)
  categoriamapeo categoriamapeo[]
  products       products[]
}

model products {
  idProduct       BigInt          @id @default(autoincrement())
  idProductExt    String?         @db.VarChar(255)
  name            String          @db.VarChar(150)
  description     String?         @db.Text
  caracteristicas Json?
  price           Decimal         @db.Decimal(10, 2)
  stock           Int
  sku             String?         @db.VarChar(255)
  upc             String?         @db.VarChar(255)
  width           Float?
  height          Float?
  largo           Float?
  peso            Float?
  rating          Float?
  image_url       Json?
  categoryId      BigInt?
  marcaId         BigInt?
  providerId      BigInt
  isPC            Int?            @db.TinyInt
  createdAt       DateTime?       @default(now()) @db.DateTime(0)
  active          Int?            @default(1) @db.TinyInt
  cartItems       cartItems[]
  favorites       favorites[]
  product_stock   product_stock[]
  categories      categories?     @relation(fields: [categoryId], references: [idCategorie], onDelete: NoAction, onUpdate: NoAction, map: "fk_categorieId_products")
  marca           marca?          @relation(fields: [marcaId], references: [idMarca], onDelete: NoAction, onUpdate: NoAction, map: "fk_marcaId_products")
  providers       providers       @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_providerId_products")
  reviews         reviews[]
  sales           sales[]

  @@index([providerId], map: "fk_providerId_products_idx")
  @@index([marcaId], map: "fk_marcaId_products_idx")
  @@index([categoryId], map: "fk_categoriaId_products_idx")
}

model providers {
  idProvider         BigInt               @id @default(autoincrement())
  companyName        String               @db.VarChar(100)
  contactEmail       String?              @db.VarChar(100)
  phone              String?              @db.VarChar(50)
  address            String?              @db.Text
  branches           branches[]
  categoriamapeo     categoriamapeo[]
  marcamapeo         marcamapeo[]
  products           products[]
  products_providers products_providers[]
}

model users {
  idUser         BigInt           @id @default(autoincrement())
  name           String           @db.VarChar(100)
  lastname       String?          @db.VarChar(100)
  email          String           @db.VarChar(100)
  password       String?          @db.VarChar(255)
  phone          String?          @db.VarChar(45)
  role           users_role       @default(customer)
  customerId     String?          @db.VarChar(255)
  createdAT      DateTime?        @default(now()) @db.DateTime(0)
  active         Int?             @default(1) @db.TinyInt
  addresses      addresses[]
  billing        billing[]
  cards          cards[]
  carts          carts[]
  changepassword changepassword[]
  favorites      favorites[]
  order          order[]
  reservas       reservas[]
  resetpassword  resetpassword[]
  sales          sales[]
}

model resetpassword {
  idResetPassword BigInt    @id @default(autoincrement())
  idUser          BigInt
  refreshToken    String    @db.VarChar(255)
  expiryToken     String    @db.VarChar(255)
  createdAT       DateTime? @default(now()) @db.DateTime(0)
  active          Boolean   @default(true)
  users           users     @relation(fields: [idUser], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "resetpassword_ibfk_1")

  @@index([idUser], map: "idUser")
}

model cartItems {
  idCartItem BigInt   @id @default(autoincrement())
  carId      BigInt
  productId  BigInt
  storeId    Int?
  quantity   Int?
  active     Int?     @default(1) @db.TinyInt
  carts      carts    @relation(fields: [carId], references: [idCart], onDelete: NoAction, onUpdate: NoAction, map: "fk_card_id_cart")
  products   products @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_id_cart")

  @@index([carId], map: "fk_card_id_cart_idx")
  @@index([productId], map: "fk_product_id_cart_idx")
  @@map("cart_items")
}

model carts {
  idCart    BigInt        @id @default(autoincrement())
  userId    BigInt
  status    carts_status? @default(active)
  createdAt DateTime?     @default(now()) @db.DateTime(0)
  cartItems cartItems[]
  users     users         @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_userId_car")

  @@index([userId], map: "fk_userId_car_idx")
}

model changepassword {
  idChangePassword BigInt    @id @default(autoincrement())
  userId           BigInt
  createdAt        DateTime? @default(now()) @db.DateTime(0)
  users            users     @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "changepassword_ibfk_1")

  @@index([userId], map: "userId")
}

model addresses {
  idAddress  BigInt      @id @default(autoincrement())
  userId     BigInt
  street     String?     @db.VarChar(255)
  noExt      String      @db.VarChar(10)
  noInt      String?     @db.VarChar(10)
  cologne    String?     @db.VarChar(100)
  city       String?     @db.VarChar(100)
  state      String?     @db.VarChar(100)
  country    String?     @db.VarChar(100)
  postalCode String?     @db.VarChar(10)
  phone1     String?     @db.VarChar(100)
  phone2     String?     @db.VarChar(100)
  createdAt  DateTime?   @default(now()) @db.DateTime(0)
  updatedAt  DateTime?   @default(now()) @db.DateTime(0)
  active     Int?        @default(1) @db.TinyInt
  users      users       @relation(fields: [userId], references: [idUser], onDelete: Cascade, onUpdate: NoAction, map: "addresses_ibfk_1")
  shipments  shipments[]

  @@index([userId], map: "userId")
}

model billing {
  idBilling    BigInt             @id @default(autoincrement())
  userId       BigInt
  companyName  String?            @db.VarChar(100)
  rfc          String?            @db.VarChar(100)
  cfdi         String?            @db.VarChar(50)
  taxRegimen   String?            @db.VarChar(50)
  methodPay    billing_methodPay?
  codePostal   String?            @db.VarChar(10)
  cologne      String?            @db.VarChar(50)
  state        String?            @db.VarChar(100)
  city         String?            @db.VarChar(100)
  street       String?            @db.VarChar(100)
  noExt        String?            @db.VarChar(50)
  noInt        String?            @db.VarChar(50)
  observations String?            @db.Text
  country      billing_country?   @default(M_xico)
  createdAt    DateTime?          @default(now()) @db.DateTime(0)
  users        users              @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "billing_ibfk_1")

  @@index([userId], map: "userId")
}

model reviews {
  idReview     BigInt    @id @default(autoincrement())
  productId    BigInt
  rating       Float?
  title        String?   @db.VarChar(255)
  description  String?   @db.VarChar(255)
  date         DateTime? @db.DateTime(0)
  reviewerName String?   @db.VarChar(100)
  userId       BigInt?
  products     products  @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_1")

  @@index([productId], map: "productId")
}

model favorites {
  idFavorite  BigInt    @id @default(autoincrement())
  userId      BigInt
  productId   BigInt
  favoritedAt DateTime? @default(now()) @db.DateTime(0)
  active      Int?      @default(1) @db.TinyInt
  users       users     @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "favorites_ibfk_1")
  products    products  @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "favorites_ibfk_2")

  @@index([productId], map: "productId")
  @@index([userId], map: "userId")
}

model cards {
  idRegisterCard  BigInt    @id @default(autoincrement())
  userId          BigInt?
  cardId          String?   @db.VarChar(255)
  lastFourDigits  String?   @db.VarChar(4)
  brand           String?   @db.VarChar(250)
  expirationMonth Int?
  expirationYear  Int?
  createdAt       DateTime? @default(now()) @db.Timestamp(0)
  active          Int?      @default(1) @db.TinyInt
  users           users?    @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "cards_ibfk_1")

  @@index([userId], map: "userId")
}

model order {
  idOrder               BigInt                 @id @default(autoincrement())
  userId                BigInt
  totalAmount           Decimal                @db.Decimal(10, 2)
  idPreferenceMP        String?                @db.Text
  idPayMP               String?                @db.Text
  stripePaymentIntentId String?                @db.VarChar(255)
  status                order_status?
  paidAtOxxo            Int?
  shipping_method       order_shipping_method?
  pay_method            order_pay_method?
  oxxo_reference        String?                @db.VarChar(255)
  gatewayPaymentId      String?                @db.VarChar(255)
  payment_plan          Int?
  createdAt             DateTime?              @db.DateTime(0)
  updatedAt             DateTime?              @db.DateTime(0)
  requiredFactura       Int?                   @db.TinyInt
  active                Int?                   @default(1) @db.TinyInt
  users                 users                  @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_userId_order")
  purchases             purchases[]
  refunds               refunds[]
  sales                 sales[]
  shipments             shipments[]
  techsmart_orders      techsmart_orders?

  @@index([userId], map: "fk_userId_order_idx")
}

model techsmart_orders {
  idTechsmartOrder BigInt                  @id @default(autoincrement())
  idOrder          BigInt                  @unique
  folioPedido      String?                 @db.VarChar(100)
  xmlPedido        String?                 @db.LongText
  guiaPedido       String?                 @db.VarChar(255)
  nombrePaqueteria String?                 @db.VarChar(100)
  folioFactura     String?                 @db.VarChar(100)
  fechaFactura     String?                 @db.VarChar(50)
  plazoFactura     String?                 @db.VarChar(50)
  status           techsmart_orders_status @default(pending)
  wsError          String?                 @db.Text
  createdAt        DateTime                @default(now()) @db.DateTime(0)
  updatedAt        DateTime                @updatedAt @db.DateTime(0)
  order            order                   @relation(fields: [idOrder], references: [idOrder], onDelete: Cascade, onUpdate: NoAction, map: "fk_techsmart_orders_idOrder")

  @@index([idOrder], map: "fk_techsmart_orders_idOrder_idx")
}

model shipments {
  idShipment       BigInt                     @id @default(autoincrement())
  orderId          BigInt?
  addressId        BigInt?
  trackingNumber   String?                    @db.VarChar(255)
  lastStatus       String?                    @db.VarChar(255)
  lastLocation     String?                    @db.VarChar(255)
  lastUpdated      DateTime?                  @db.DateTime(0)
  status           shipments_status?
  storeId          Int?
  shipping_method  shipments_shipping_method?
  createdAt        DateTime?                  @db.DateTime(0)
  requireInsurance Int?                       @db.TinyInt
  sales            sales[]
  order            order?                     @relation(fields: [orderId], references: [idOrder], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_id_shipments")
  addresses        addresses?                 @relation(fields: [addressId], references: [idAddress], onDelete: NoAction, onUpdate: NoAction, map: "fn_addressId_shipments")

  @@index([orderId], map: "fk_order_id_shipments_idx")
  @@index([addressId], map: "db_address_id_shipments_idx")
}

model refunds {
  idRefund        BigInt          @id @default(autoincrement())
  orderId         BigInt?
  amount          Int?
  reason          String?         @db.VarChar(255)
  status          refunds_status?
  gatewayRefundId String?         @db.VarChar(255)
  createdAt       DateTime?       @default(now()) @db.DateTime(0)
  updatedAt       DateTime?       @db.DateTime(0)
  order           order?          @relation(fields: [orderId], references: [idOrder], onDelete: NoAction, onUpdate: NoAction, map: "refunds_ibfk_1")

  @@index([orderId], map: "orderId")
}

model transfers {
  idTransfer        BigInt            @id @default(autoincrement())
  amount            Int?
  currency          String?           @db.VarChar(50)
  status            transfers_status?
  gatewayTransferId String?           @db.VarChar(255)
  createdAt         DateTime?         @default(now()) @db.DateTime(0)
  updatedAt         DateTime?         @db.DateTime(0)
}

model marca {
  idMarca     BigInt       @id @default(autoincrement())
  name        String?      @db.VarChar(255)
  description String?      @db.VarChar(255)
  marcamapeo  marcamapeo[]
  products    products[]
}

model sales {
  idSale        BigInt        @id @default(autoincrement())
  orderId       BigInt
  shipmentId    BigInt?
  productId     BigInt
  userId        BigInt
  purchaseId    String?       @db.VarChar(255)
  invoiceNumber String?       @db.VarChar(255)
  quantity      Int?
  total         Decimal?      @db.Decimal(10, 2)
  status        sales_status?
  createdAt     DateTime?     @default(now()) @db.DateTime(0)
  order         order         @relation(fields: [orderId], references: [idOrder], onDelete: NoAction, onUpdate: NoAction, map: "fk_orderId_sales")
  products      products      @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_productId_sales")
  shipments     shipments?    @relation(fields: [shipmentId], references: [idShipment], onDelete: NoAction, onUpdate: NoAction, map: "fk_shipmentId_sales")
  users         users         @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_userId_sales")

  @@index([orderId], map: "fk_orderId_sales_idx")
  @@index([productId], map: "fk_productId_sales")
  @@index([userId], map: "fk_userId_sales")
  @@index([shipmentId], map: "fk_shipmentId_sales_idx")
}

model categoriamapeo {
  idCategoriaMapeo BigInt      @id @default(autoincrement())
  nameExt          String      @db.VarChar(255)
  providerId       BigInt?
  categoriaLocalId BigInt?
  createdAt        DateTime?   @default(now()) @db.DateTime(0)
  categories       categories? @relation(fields: [categoriaLocalId], references: [idCategorie], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoriamapeo_categoriasLocalId")
  providers        providers?  @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoriamapeo_providerId")

  @@index([categoriaLocalId], map: "fk_categoriamapeo_categoriasLocalId_idx")
  @@index([providerId], map: "fk_categoriamapeo_providerId_idx")
}

model marcamapeo {
  idMarcaMapeo BigInt    @id @default(autoincrement())
  nameExt      String    @db.VarChar(255)
  providerId   BigInt
  marcaLocalId BigInt
  createdAt    DateTime  @default(now()) @db.DateTime(0)
  marca        marca     @relation(fields: [marcaLocalId], references: [idMarca], onDelete: NoAction, onUpdate: NoAction, map: "fk_marcamapeo_marcaLocalId")
  providers    providers @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_marcamapeo_providerId")

  @@index([providerId], map: "fk_maramapeo_providerId_idx")
  @@index([marcaLocalId], map: "fk_marcamapeo_marcaLocalId_idx")
}

model branches {
  idBranche     BigInt          @id @default(autoincrement())
  name          String?         @db.VarChar(255)
  city          String?         @db.VarChar(255)
  providerId    BigInt
  providers     providers       @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_providerId_branches")
  product_stock product_stock[]

  @@index([providerId], map: "fk_providerId_branches_idx")
}

model product_stock {
  idProductStock BigInt   @id @default(autoincrement())
  productId      BigInt
  branchId       BigInt
  stock          Int?
  branches       branches @relation(fields: [branchId], references: [idBranche], onDelete: NoAction, onUpdate: NoAction, map: "fk_branchId_product_stock")
  products       products @relation(fields: [productId], references: [idProduct], onDelete: NoAction, onUpdate: NoAction, map: "fk_productId_product_stock")

  @@index([branchId], map: "fk_branchId_product_stock_idx")
  @@index([productId], map: "fk_productId_product_stock")
}

model products_providers {
  idProductProvider BigInt    @id @default(autoincrement())
  idProductExt      String    @unique(map: "idProductExt_UNIQUE") @db.VarChar(255)
  providerId        BigInt
  name              String?   @db.VarChar(255)
  description       String?   @db.VarChar(255)
  price             Decimal?  @db.Decimal(10, 2)
  profitMargin      Decimal?  @db.Decimal(10, 2)
  stock             Int?
  sku               String?   @db.VarChar(255)
  image_url         Json?
  upc               String?   @db.VarChar(255)
  width             Float?
  height            Float?
  largo             Float?
  peso              Float?
  caracteristicas   Json?
  isPC              Int?      @db.TinyInt
  active            Int?      @db.TinyInt
  dolares           Int?      @db.TinyInt
  providers         providers @relation(fields: [providerId], references: [idProvider], onDelete: NoAction, onUpdate: NoAction, map: "fk_providerId_products_providers")

  @@index([providerId], map: "fk_providerId_products_providers_idx")
}

model shippingbyzone {
  idShippingByZone BigInt @id @default(autoincrement())
  name             String @db.VarChar(255)
  price            Float
  active           Int?   @default(1) @db.TinyInt
}

model link_pagos {
  idLinkPago      Int                         @id @default(autoincrement())
  email           String?                     @db.VarChar(255)
  monto           Float?
  description     String?                     @db.Text
  referencia      String?                     @db.VarChar(255)
  name            String?                     @db.VarChar(255)
  lastname        String?                     @db.VarChar(255)
  customerId      String?                     @db.VarChar(255)
  products        Json?
  linkMP          String?                     @db.Text
  linkOP          String?                     @db.Text
  status          link_pagos_status?          @default(payment_pending)
  phone           String?                     @db.Text
  transactionMP   String?                     @db.Text
  transactionOP   String?                     @db.Text
  pay_method      link_pagos_pay_method?
  createdAt       DateTime?                   @default(now()) @db.DateTime(0)
  expiredAt       DateTime?                   @db.DateTime(0)
  updatedAt       DateTime?                   @db.DateTime(0)
  statusShip      link_pagos_statusShip?
  state           String?                     @db.VarChar(255)
  city            String?                     @db.VarChar(255)
  street          String?                     @db.Text
  noExt           String?                     @db.Text
  noInt           String?                     @db.Text
  cologne         String?                     @db.Text
  codePostal      Int?
  deliveryType    link_pagos_deliveryType?
  payment_plan    Int?
  deliveryService link_pagos_deliveryService?
  purchaseId      String?                     @db.Text
  invoiceNumber   String?                     @db.Text
  guia            String?                     @db.Text
}

model purchases {
  idPurchases Int       @id @default(autoincrement())
  idOrder     BigInt?
  storeId     Int?
  products    Json?
  purchaseId  Int?
  invoiceId   Int?
  createdAt   DateTime? @default(now()) @db.DateTime(0)
  order       order?    @relation(fields: [idOrder], references: [idOrder], onDelete: NoAction, onUpdate: NoAction, map: "fk_purchases_idOrder")

  @@index([idOrder], map: "fk_purchases_idOrder_idx")
}

model reservas {
  idReserva    BigInt              @id @default(autoincrement())
  reference    String              @unique(map: "uk_reservas_reference") @db.VarChar(50)
  service      String              @db.VarChar(100)
  deviceType   reservas_deviceType
  brand        String              @db.VarChar(100)
  model        String              @db.VarChar(100)
  description  String              @db.Text
  date         DateTime            @db.Date
  time         String              @db.VarChar(50)
  contactName  String              @db.VarChar(255)
  contactEmail String              @db.VarChar(255)
  contactPhone String              @db.VarChar(50)
  status       String              @default("pending") @db.VarChar(50)
  cancelReason String?             @db.Text
  userId       BigInt?
  createdAt    DateTime?           @default(now()) @db.DateTime(0)
  updatedAt    DateTime?           @default(now()) @updatedAt @db.DateTime(0)
  users        users?              @relation(fields: [userId], references: [idUser], onDelete: NoAction, onUpdate: NoAction, map: "fk_userId_reservas")

  @@index([userId], map: "idx_reservas_userId")
}

enum users_role {
  customer
  provider
  admin
}

enum carts_status {
  active
  completed
}

enum billing_country {
  M_xico @map("México")
}

enum transfers_status {
  initiated
  pending
  succeeded
  failed
}

enum order_status {
  paid
  pending
  payment_pending
  cancelled
  rejected
  refunded
  charged_back
}

enum refunds_status {
  succeeded
  pending
  failed
}

enum sales_status {
  paid
  pending
  failed
  cancelled
}

enum order_shipping_method {
  sucursal
  paqueteexpress
  dhl
  estafeta
  envioLeon
}

enum order_pay_method {
  oxxo
  efectivo_sucursal
  tarjeta_de_credito
  tarjeta_de_debito
  transferencia_bancaria
  tarjeta_sucursal
  mercadopago
  esperando
}

enum billing_methodPay {
  Efectivo
  Tarjeta_de_Credito     @map("Tarjeta de Credito")
  Tarjeta_de_Debito      @map("Tarjeta de Debito")
  Mercado_Pago           @map("Mercado Pago")
  transferencia_bancaria
}

enum shipments_status {
  entregado
  cancelado
  enviado
  procesando
  disponible
}

enum link_pagos_statusShip {
  entregado
  disponible
  enviado
  cancelado
  procesando
}

enum shipments_shipping_method {
  sucursal
  paqueteexpress
  dhl
  estafeta
  envioLeon
  sucursalExt
}

enum reservas_deviceType {
  Laptop
  PC
}

enum link_pagos_status {
  paid
  payment_pending
  failed
  cancelled
  expired
  charged_back
  rejected
  refunded
}

enum link_pagos_pay_method {
  tarjeta_de_credito
  tarjeta_de_debito
  transferencia_bancaria
  oxxo
  esperando
  mercadopago
}

enum link_pagos_deliveryType {
  sucursal
  domicilio
}

enum link_pagos_deliveryService {
  Estafeta
  Paquete_Express @map("Paquete Express")
}

enum techsmart_orders_status {
  pending
  sent
  guide_linked
  invoiced
  failed
}
