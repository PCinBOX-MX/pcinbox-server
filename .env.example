# Copiar a .env.local

PORT=8000
SERVER_PORT=8000
SERVER=http://localhost:8000
BASE_URL_APP=http://localhost:3000
NODE_ENV=local
DATABASE_URL=mysql://user:pass@localhost:3306/pcinbox_db?connection_limit=10&pool_timeout=20
KEY_JWT=change-me

# Pasarela (checkout web / otros; el POS ya no genera links de pago)
API_URL_PAGOS=http://localhost:8009/api/v1

# Opcional (emails / etc.)
RESEND_KEY=
FROM_EMAIL=

# Opcional: clave AES-256 (hex 64 o base64 32 bytes). Si falta, se deriva de KEY_JWT.
COTIZACIONES_PHONE_ENCRYPTION_KEY=

# Redis (cache + BullMQ mail)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=pcinbox:
QUEUE_ENABLED=true
MAIL_QUEUE_CONCURRENCY=3
MAIL_QUEUE_MAX_ATTEMPTS=5
