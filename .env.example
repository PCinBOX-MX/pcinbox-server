# Copiar a .env.local

PORT=8000
SERVER_PORT=8000
SERVER=http://localhost:8000
BASE_URL_APP=http://localhost:3000
NODE_ENV=local
DATABASE_URL=mysql://user:pass@localhost:3306/pcinbox_db
KEY_JWT=change-me

# Pasarela (checkout web / otros; el POS ya no genera links de pago)
API_URL_PAGOS=http://localhost:8009/api/v1

# Opcional (emails / etc.)
RESEND_KEY=
FROM_EMAIL=

# Opcional: clave AES-256 (hex 64 o base64 32 bytes). Si falta, se deriva de KEY_JWT.
COTIZACIONES_PHONE_ENCRYPTION_KEY=

# Registro: bloqueo por intentos con correos temporales / dominio inválido (por IP)
# REGISTER_FAKE_MAX_ATTEMPTS=5
# REGISTER_FAKE_WINDOW_MS=600000
# REGISTER_FAKE_LOCKOUT_MS=1800000

# Registro: bloqueo por muchos códigos de verificación enviados (IP + deviceId)
# REGISTER_CODE_MAX_SENDS=5
# REGISTER_CODE_WINDOW_MS=900000
# REGISTER_CODE_LOCKOUT_MS=1800000

