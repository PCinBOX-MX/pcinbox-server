# Copiar a .env.local

PORT=8000
SERVER_PORT=8000
SERVER=http://localhost:8000
BASE_URL_APP=http://localhost:3000
NODE_ENV=local
DATABASE_URL=mysql://user:pass@localhost:3306/pcinbox_db
KEY_JWT=change-me

# Requerido para POS: generar links OpenPay vía pasarela
API_URL_PAGOS=http://localhost:8009/api/v1

# Secreto compartido con la pasarela para auto-completar ventas POS (OpenPay)
POS_INTERNAL_SECRET=change-me-pos-internal

# Opcional (pasarela / emails / etc.)
RESEND_KEY=
FROM_EMAIL=
