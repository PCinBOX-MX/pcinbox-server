{
  "name": "pcinbox-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "npm config set ignore-scripts false",
    "generate": "npx prisma generate",
    "build": "npm run generate && npx tsc",
    "dev": "npx kill-port 8000 && dotenv -e .env.local nodemon src/server.ts",
    "dev:prod": "npx kill-port 8000 && dotenv -e .env.prod nodemon src/server.ts",
    "migrate:dev": "npx dotenv -e .env.local -- npx prisma migrate dev --name migraciondev",
    "start:dev": "dotenv -e .env.prod node dist/server.js",
    "start": "node dist/server.js",
    "migrate:start": "npx dotenv -e .env.prod -- npx prisma db push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@pcinbox/core": "file:../pcinbox-core",
    "@prisma/client": "^6.15.0",
    "@sendgrid/mail": "^8.1.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemon": "^1.19.6",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.1",
    "dotenv-flow": "^4.1.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nanoid": "^5.1.5",
    "nodemon": "^3.1.10",
    "resend": "^6.12.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
